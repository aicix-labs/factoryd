{
  "schema_version": 3,
  "name": "widgets",
  "provider": "gitlab",
  "gitlab": {
    "base_url": "https://gitlab.example.com/api/v4",
    "project": "acme/widgets",
    "remove_source_branch": true
  },
  "target_branch": "main",
  "git": {
    "remote": "https://gitlab.example.com/acme/widgets.git",
    "transport": "https"
  },
  "paths": {
    "root": "/var/lib/factoryd/widgets",
    "producer_workdir": "/var/lib/factoryd/widgets/clone",
    "submit_repo": "/var/lib/factoryd/widgets/submit"
  },
  "credentials": {
    "producer": {
      "env": "FACTORYD_PRODUCER_TOKEN"
    },
    "reviewer": {
      "file": "/etc/factoryd/widgets/reviewer.token"
    }
  },
  "gate": {
    "command": [
      "make",
      "check"
    ],
    "env": {
      "PATH": "/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin",
      "HOME": "/var/lib/factoryd/widgets",
      "GOCACHE": "/var/cache/factoryd/widgets/go",
      "GOFLAGS": "-count=1"
    },
    "required_writable_paths": [
      "${GOCACHE}"
    ],
    "run_as": {
      "user": "factoryd-gate"
    },
    "timeout_seconds": 900
  },
  "roles": {
    "producer": {
      "command": [
        "/usr/local/bin/factory-producer-turn"
      ],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": "/var/lib/factoryd/widgets"
      },
      "timeout_seconds": 3600,
      "run_as": {
        "user": "factoryd-producer"
      }
    },
    "reviewer": {
      "command": [
        "/usr/local/bin/factory-reviewer-turn"
      ],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": "/var/lib/factoryd/widgets"
      },
      "timeout_seconds": 1800
    }
  },
  "supervisor": {
    "spin_warn": 3,
    "spin_abort": 8,
    "poll_interval_seconds": 2,
    "backoff_seconds": 15
  },
  "alerts": [
    {
      "kind": "webhook",
      "url": "https://hooks.example.com/factoryd"
    }
  ]
}
