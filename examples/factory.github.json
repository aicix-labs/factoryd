{
  "schema_version": 5,
  "name": "widgets",
  "provider": "github",
  "github": {
    "owner": "acme",
    "repo": "widgets",
    "merge_method": "merge"
  },
  "target_branch": "main",
  "git": {
    "remote": "https://github.com/acme/widgets.git",
    "transport": "https"
  },
  "paths": {
    "root": "/var/lib/factoryd/widgets",
    "producer_workdir": "/var/lib/factoryd/widgets/clone",
    "submit_repo": "/var/lib/factoryd/widgets/submit",
    "cache_root": "/var/cache/factoryd/widgets"
  },
  "credentials": {
    "producer": {
      "file": "/etc/factoryd/widgets/producer.token"
    },
    "reviewer": {
      "file": "/etc/factoryd/widgets/reviewer.token"
    },
    "operator": {
      "file": "/etc/factoryd/widgets/operator.token"
    }
  },
  "gate": {
    "command": [
      "bash",
      "-c",
      "set -e; go build ./... && go vet ./... && go test -count=1 ./... && unformatted=$(find . -path ./.git -prune -o -name '*.go' -print0 | xargs -0 -r gofmt -l) && test -z \"$unformatted\" || { echo \"unformatted: $unformatted\"; exit 1; }"
    ],
    "env": {
      "PATH": "/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin",
      "HOME": "/var/lib/factoryd/widgets",
      "GOCACHE": "/var/cache/factoryd/widgets/go",
      "GOFLAGS": "-count=1 -buildvcs=false"
    },
    "required_writable_paths": [
      "${GOCACHE}"
    ],
    "run_as": {
      "user": "factoryd-gate"
    },
    "timeout_seconds": 900
  },
  "roles": {
    "producer": {
      "command": [
        "/usr/local/bin/factory-producer-turn"
      ],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": "/var/lib/factoryd/widgets"
      },
      "timeout_seconds": 3600,
      "run_as": {
        "user": "factoryd-producer"
      }
    },
    "reviewer": {
      "command": [
        "/usr/local/bin/factory-reviewer-turn"
      ],
      "run_as": { "user": "factoryd-reviewer" },
      "env": {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "HOME": "/var/lib/factoryd/widgets"
      },
      "timeout_seconds": 1800
    }
  },
  "supervisor": {
    "spin_warn": 3,
    "spin_abort": 8,
    "poll_interval_seconds": 2,
    "backoff_seconds": 15
  },
  "alerts": [
    {
      "kind": "file",
      "path": "/var/log/factoryd/widgets-alerts.log"
    },
    {
      "kind": "command",
      "command": [
        "/usr/local/bin/notify-operator"
      ],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin:/bin"
      },
      "timeout_seconds": 30
    }
  ],
  "health": {
    "interval_seconds": 60,
    "alert_after": 3,
    "repeat_seconds": 1800,
    "stale_trigger_seconds": 900,
    "turn_grace_seconds": 120,
    "unreviewed_seconds": 0,
    "disk_min_free_percent": 10,
    "caches": [
      {
        "path": "/var/cache/factoryd/widgets/go",
        "max_bytes": 5368709120
      }
    ]
  },
  "scope": {
    "deny_regexes": [
      "^\\.github/workflows/",
      "^\\.gitlab-ci\\.yml$",
      "(^|/)Dockerfile$",
      "^deploy/"
    ],
    "allow_regexes": [
      "^deploy/.*\\.md$"
    ],
    "hold_diff_regexes": [
      "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "\\bghp_[A-Za-z0-9]{20,}",
      "\\bglpat-[A-Za-z0-9_-]{20,}",
      "\\bAKIA[0-9A-Z]{16}\\b"
    ],
    "escalate_regexes": [
      "(^|/)(auth|authn|authz|login|session|oauth|jwt|token)",
      "(^|/)(crypto|tls|ssl|cert|secret|vault|password)",
      "(^|/)(iam|policy|acl|permission|rbac)"
    ]
  }
}
